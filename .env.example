# Velvety environment template
#
# Phase 1 runs without any of these values: the catalog is empty by design.
# Phase 2 wires Supabase (database, storage, RLS). Copy this file to .env and
# fill it locally. Never commit .env.

# ---------------------------------------------------------------------------
# Supabase — client-safe values. These two are the only Supabase values that
# may ever reach the app bundle. RLS on every table is the security boundary.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-only values (Supabase Edge Functions / payment webhook handlers).
# They must NOT be prefixed with EXPO_PUBLIC_ and must never be bundled.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
# Egyptian shipping provider credentials (Phase 2 integration TBD).
SHIPPING_API_KEY=
